# Copy to .env and fill in. Never commit .env — it may hold secrets.
# See README.md quickstart: cp .env.example .env

# --- API ---
API_PORT=4000
# Local-dev API key for the example client. CHANGE THIS in any shared deployment.
# The server stores only a hash; this plaintext exists only so the local example works.
AGENTOS_DEV_API_KEY=dev-local-key-change-me

# --- Database ---
# Leave unset for SQLite (default, zero-config). Set to a postgres:// URL to use Postgres.
# DATABASE_URL=postgres://user:password@localhost:5432/agentos
SQLITE_PATH=./data/control-plane.db

# --- Web ---
WEB_PORT=3000
API_BASE_URL=http://localhost:4000

# --- Providers (all optional in v0.1) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
