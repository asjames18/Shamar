{
  "description": "Open-source control plane for an organization's AI workforce (working dir: agentos).",
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "ai-workforce-control-plane",
  "private": true,
  "scripts": {
    "build": "tsc -b apps/api packages/types packages/sdk",
    "dev:api": "npm --workspace apps/api run dev",
    "lint": "npx eslint apps/api/src packages/types/src packages/sdk/src --max-warnings=0",
    "test": "npm run build && node --test apps/api/dist/test/*.test.js packages/sdk/dist/test/*.test.js",
    "typecheck": "tsc -b apps/api packages/types packages/sdk --pretty"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}